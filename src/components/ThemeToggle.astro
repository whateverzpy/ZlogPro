---
import { Monitor, Moon, Sun } from '@lucide/astro';
---

<div
	class="theme-toggle"
	role="group"
	aria-label="颜色模式"
	data-theme-toggle
>
	<button
		class="theme-mode-button"
		type="button"
		aria-label="浅色模式"
		title="浅色模式"
		data-theme-option="light"
	>
		<Sun class="theme-toggle-icon" size={15} stroke-width={1.8} aria-hidden="true" />
	</button>
	<button
		class="theme-mode-button"
		type="button"
		aria-label="深色模式"
		title="深色模式"
		data-theme-option="dark"
	>
		<Moon class="theme-toggle-icon" size={15} stroke-width={1.8} aria-hidden="true" />
	</button>
	<button
		class="theme-mode-button"
		type="button"
		aria-label="跟随系统"
		title="跟随系统"
		data-theme-option="system"
	>
		<Monitor class="theme-toggle-icon" size={15} stroke-width={1.8} aria-hidden="true" />
	</button>
</div>
