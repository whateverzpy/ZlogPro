---
import { Search } from '@lucide/astro';
import CodeBlockEnhancer from '../components/CodeBlockEnhancer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css'
import 'katex/dist/katex.min.css'

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'ZlogPro',
	description = 'A personal blog and docs site built with Astro.',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
		<script is:inline>
			(() => {
				const storageKey = 'zlogpro-theme';
				const validModes = ['light', 'dark', 'system'];
				let storedTheme;

				try {
					storedTheme = localStorage.getItem(storageKey);
				} catch {
					storedTheme = null;
				}

				const themeMode = validModes.includes(storedTheme) ? storedTheme : 'system';
				document.documentElement.dataset.themeMode = themeMode;

				if (themeMode === 'light' || themeMode === 'dark') {
					document.documentElement.dataset.theme = themeMode;
				} else {
					document.documentElement.removeAttribute('data-theme');
				}
			})();
		</script>
	</head>
	<body>
		<header class="site-header">
			<nav class="page-container site-nav" aria-label="主导航">
				<a class="site-logo" href="/">ZlogPro</a>
				<div class="site-nav-actions">
					<div class="site-nav-links">
						<a class="site-nav-link" href="/blog/">Blog</a>
						<a class="site-nav-link" href="/docs/">Docs</a>
					</div>
					<a class="site-icon-link" href="/search/" aria-label="全站搜索" title="全站搜索">
						<Search size={17} stroke-width={1.8} aria-hidden="true" />
					</a>
					<ThemeToggle />
				</div>
			</nav>
		</header>
		<main class="page-container site-main">
			<slot />
		</main>
		<CodeBlockEnhancer />
		<script is:inline>
			const storageKey = 'zlogpro-theme';
			const root = document.documentElement;
			const themeOptions = Array.from(document.querySelectorAll('[data-theme-option]'));
			const themeModes = ['light', 'dark', 'system'];

			const getStoredThemeMode = () => {
				try {
					return localStorage.getItem(storageKey);
				} catch {
					return null;
				}
			};

			const normalizeThemeMode = (mode) => (themeModes.includes(mode) ? mode : 'system');

			const setThemeControlsState = (themeMode) => {
				for (const option of themeOptions) {
					const isActive = option.dataset.themeOption === themeMode;
					option.setAttribute('aria-pressed', String(isActive));
				}
			};

			const applyThemeMode = (mode, persist = true) => {
				const themeMode = normalizeThemeMode(mode);
				root.dataset.themeMode = themeMode;

				if (themeMode === 'light' || themeMode === 'dark') {
					root.dataset.theme = themeMode;
				} else {
					root.removeAttribute('data-theme');
				}

				if (persist) {
					try {
						localStorage.setItem(storageKey, themeMode);
					} catch {
						// Theme still changes for the current page when storage is unavailable.
					}
				}

				setThemeControlsState(themeMode);
			};

			applyThemeMode(root.dataset.themeMode ?? getStoredThemeMode(), false);

			for (const option of themeOptions) {
				option.addEventListener('click', () => {
					applyThemeMode(option.dataset.themeOption);
				});
			}

			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
				if (root.dataset.themeMode === 'system') {
					applyThemeMode('system', false);
				}
			});

			const restartClassAnimation = (element, className) => {
				if (!element) return;
				element.classList.remove(className);
				void element.offsetWidth;
				element.classList.add(className);
			};

			const getHashTarget = (hash) => {
				if (!hash || hash === '#') return null;
				const rawId = hash.slice(1);
				try {
					return document.getElementById(decodeURIComponent(rawId)) ?? document.getElementById(rawId);
				} catch {
					return document.getElementById(rawId);
				}
			};

			const highlightTarget = (target) => {
				if (!target) return;
				const context = target.closest('.prose-content :is(p, li, blockquote, td, th)');
				restartClassAnimation(context, 'is-target-context-highlight');
				restartClassAnimation(target, 'is-target-highlight');
			};

			document.addEventListener('click', (event) => {
				const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
				if (!link) return;

				const targetUrl = new URL(link.href, window.location.href);
				if (
					targetUrl.origin !== window.location.origin ||
					targetUrl.pathname !== window.location.pathname ||
					targetUrl.search !== window.location.search ||
					!targetUrl.hash
				) {
					return;
				}

				const target = getHashTarget(targetUrl.hash);
				if (!target) return;

				event.preventDefault();
				if (window.location.hash !== targetUrl.hash) {
					window.history.pushState(null, '', targetUrl.hash);
				} else {
					window.history.replaceState(null, '', targetUrl.hash);
				}

				target.scrollIntoView({ block: 'start' });
				highlightTarget(target);
			});

			window.addEventListener('hashchange', () => {
				highlightTarget(getHashTarget(window.location.hash));
			});
		</script>
	</body>
</html>
