---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const docs = (await getCollection('docs', ({ data }) => !data.draft)).sort((a, b) =>
	a.id.localeCompare(b.id),
);
---

<Layout title="Docs | ZlogPro" description="ZlogPro 的文档与参考材料">
	<section class="page-section article-header">
		<p class="page-kicker">Docs</p>
		<h1 class="page-heading">文档</h1>
		<p class="page-description">
			面向复用和查阅的文档区，收纳更稳定的说明、指南和项目参考。
		</p>
	</section>

	<section class="entry-list" aria-label="文档列表">
		{docs.map((doc) => (
			<a class="entry-row" href={`/docs/${doc.id}/`}>
				<span class="entry-row-date">{doc.id}</span>
				<span class="entry-row-body">
					<strong class="entry-title">{doc.data.title}</strong>
					<small class="entry-summary">{doc.data.description}</small>
					{doc.data.tags.length > 0 && (
						<span class="inline-tag-list" aria-label="标签">
							{doc.data.tags.map((tag) => <span>{tag}</span>)}
						</span>
					)}
				</span>
			</a>
		))}
	</section>
</Layout>
