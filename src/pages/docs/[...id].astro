---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const docs = (await getCollection('docs', ({ data }) => !data.draft)).sort((a, b) =>
		a.id.localeCompare(b.id),
	);

	return docs.map((doc, index) => ({
		params: { id: doc.id },
		props: {
			doc,
			previousDoc: docs[index - 1],
			nextDoc: docs[index + 1],
		},
	}));
}

const { doc, previousDoc, nextDoc } = Astro.props;
const { Content } = await render(doc);

const formatDate = (date: Date) =>
	date.toLocaleDateString('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
---

<Layout title={`${doc.data.title} | ZlogPro`} description={doc.data.description}>
	<article class="page-section">
		<a class="article-back-link" href="/docs/">Docs</a>
		<header class="article-header">
			<p class="page-kicker">Docs</p>
			<h1 class="article-title">{doc.data.title}</h1>
			<p class="article-dek">{doc.data.description}</p>
			<div class="article-meta">
				<time datetime={doc.data.pubDate.toISOString()}>
					{formatDate(doc.data.pubDate)}
				</time>
				{doc.data.updatedDate && (
					<span>更新于 {formatDate(doc.data.updatedDate)}</span>
				)}
				{doc.data.author && <span>{doc.data.author}</span>}
			</div>
			{doc.data.tags.length > 0 && (
				<ul class="tag-list" aria-label="标签">
					{doc.data.tags.map((tag) => <li class="tag">{tag}</li>)}
				</ul>
			)}
		</header>
		{doc.data.heroImage && (
			<Image
				class="hero-image"
				src={doc.data.heroImage}
				alt=""
				widths={[480, 760, 1200]}
				sizes="(max-width: 820px) calc(100vw - 2.5rem), 760px"
				loading="eager"
				fetchpriority="high"
			/>
		)}
		<div class="prose-content">
			<Content />
		</div>
		<nav class="article-nav" aria-label="相邻文档">
			{previousDoc ? (
				<a href={`/docs/${previousDoc.id}/`}>
					<span>上一节</span>
					<strong>{previousDoc.data.title}</strong>
				</a>
			) : <span></span>}
			{nextDoc ? (
				<a href={`/docs/${nextDoc.id}/`}>
					<span>下一节</span>
					<strong>{nextDoc.data.title}</strong>
				</a>
			) : <span></span>}
		</nav>
	</article>
</Layout>
