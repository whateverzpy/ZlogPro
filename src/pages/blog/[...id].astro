---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	return posts.map((post, index) => ({
		params: { id: post.id },
		props: {
			post,
			previousPost: posts[index + 1],
			nextPost: posts[index - 1],
		},
	}));
}

const { post, previousPost, nextPost } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
	date.toLocaleDateString('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
---

<Layout title={`${post.data.title} | ZlogPro`} description={post.data.description}>
	<article class="page-section">
		<a class="article-back-link" href="/blog/">Blog</a>
		<header class="article-header">
			<p class="page-kicker">Blog</p>
			<h1 class="article-title">{post.data.title}</h1>
			<p class="article-dek">{post.data.description}</p>
			<div class="article-meta">
				<time datetime={post.data.pubDate.toISOString()}>
					{formatDate(post.data.pubDate)}
				</time>
				{post.data.updatedDate && (
					<span>更新于 {formatDate(post.data.updatedDate)}</span>
				)}
				{post.data.author && <span>{post.data.author}</span>}
			</div>
			{post.data.tags.length > 0 && (
				<ul class="tag-list" aria-label="标签">
					{post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
				</ul>
			)}
		</header>
		{post.data.heroImage && (
			<Image
				class="hero-image"
				src={post.data.heroImage}
				alt=""
				widths={[480, 760, 1200]}
				sizes="(max-width: 820px) calc(100vw - 2.5rem), 760px"
				loading="eager"
				fetchpriority="high"
			/>
		)}
		<div class="prose-content">
			<Content />
		</div>
		<nav class="article-nav" aria-label="相邻文章">
			{previousPost ? (
				<a href={`/blog/${previousPost.id}/`}>
					<span>上一篇</span>
					<strong>{previousPost.data.title}</strong>
				</a>
			) : <span></span>}
			{nextPost ? (
				<a href={`/blog/${nextPost.id}/`}>
					<span>下一篇</span>
					<strong>{nextPost.data.title}</strong>
				</a>
			) : <span></span>}
		</nav>
	</article>
</Layout>
