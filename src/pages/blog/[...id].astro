---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);

	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | ZlogPro`} description={post.data.description}>
	<article class="page-section">
		<header class="article-header">
			<p class="page-kicker">Blog</p>
			<h1 class="article-title">{post.data.title}</h1>
			<p class="article-dek">{post.data.description}</p>
			<div class="article-meta">
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('zh-CN')}
				</time>
				{post.data.author && <span>{post.data.author}</span>}
			</div>
			{post.data.tags.length > 0 && (
				<ul class="tag-list" aria-label="标签">
					{post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
				</ul>
			)}
		</header>
		{post.data.heroImage && (
			<Image
				class="hero-image"
				src={post.data.heroImage}
				alt=""
				widths={[480, 760, 1200]}
				sizes="(max-width: 820px) calc(100vw - 2.5rem), 760px"
				loading="eager"
				fetchpriority="high"
			/>
		)}
		<div class="prose-content">
			<Content />
		</div>
	</article>
</Layout>
