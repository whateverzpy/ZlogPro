---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const docs = (await getCollection('docs', ({ data }) => !data.draft))
	.sort((a, b) => a.id.localeCompare(b.id))
	.slice(0, 3);

const formatDate = (date: Date) =>
	date.toLocaleDateString('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
---

<Layout title="ZlogPro" description="ZlogPro 的博客文章与项目文档">
	<section class="hero-section">
		<p class="page-kicker">Blog / Docs</p>
		<h1 class="hero-heading">记录想法、项目与学习笔记</h1>
		<p class="page-description">
			Blog 用来沉淀阶段性的观察和文章，Docs 用来整理更稳定的说明、教程与参考材料。
		</p>
		<div class="button-row">
			<a class="button button-primary" href="/blog/">阅读 Blog</a>
			<a class="button button-secondary" href="/docs/">查看 Docs</a>
		</div>
	</section>

	<section class="category-grid" aria-label="内容分类">
		<section class="category-panel">
			<div class="section-heading-row">
				<div>
					<p class="page-kicker">Blog</p>
					<h2 class="section-heading">最新文章</h2>
				</div>
				<a class="text-link" href="/blog/">全部文章</a>
			</div>
			<div class="compact-entry-list">
				{blogPosts.map((post) => (
					<a class="compact-entry" href={`/blog/${post.id}/`}>
						<span class="entry-meta">{formatDate(post.data.pubDate)}</span>
						<strong class="entry-title">{post.data.title}</strong>
						<small class="entry-summary">{post.data.description}</small>
					</a>
				))}
			</div>
		</section>

		<section class="category-panel">
			<div class="section-heading-row">
				<div>
					<p class="page-kicker">Docs</p>
					<h2 class="section-heading">文档入口</h2>
				</div>
				<a class="text-link" href="/docs/">全部文档</a>
			</div>
			<div class="compact-entry-list">
				{docs.map((doc) => (
					<a class="compact-entry" href={`/docs/${doc.id}/`}>
						<span class="entry-meta">{doc.id}</span>
						<strong class="entry-title">{doc.data.title}</strong>
						<small class="entry-summary">{doc.data.description}</small>
					</a>
				))}
			</div>
		</section>
	</section>
</Layout>
